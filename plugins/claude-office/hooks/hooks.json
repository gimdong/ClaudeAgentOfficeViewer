{
  "description": "Claude Agent Office Viewer로 이벤트를 암호화해 보냅니다(relay.cjs). 대시보드가 꺼져 있거나 무엇이든 실패하면 아무것도 돌려주지 않고 끝나, 세션은 평소 권한 흐름으로 진행합니다. node·열쇠 파일 자리는 설치 스크립트가 절대 경로로 바꿉니다.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "PostToolUseFailure": [{"matcher": "*", "hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "PermissionRequest": [{"matcher": "*", "hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 600}]}],
    "PermissionDenied": [{"matcher": "*", "hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "Notification": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "TeammateIdle": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "__NODE__", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/relay.cjs", "__KEYFILE__"], "timeout": 10}]}]
  }
}
